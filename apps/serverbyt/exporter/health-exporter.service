[Unit]
Description=Host health metrics exporter for Tronbyt display
After=network.target

[Service]
Type=simple
User=aura17dev
ExecStart=/usr/bin/python3 /DATA/AppData/health-exporter/health_exporter.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/
PrivateTmp=true

[Install]
WantedBy=multi-user.target
